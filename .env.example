# FloodGuard UK — Environment Variables

# ======================================================
# LOCAL DEVELOPMENT
# (No changes needed — server defaults to local SQLite)
# ======================================================

# Optional: Turso Cloud DB (if testing cloud persistence locally)
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Express server port (defaults to 3001 locally)
# PORT=3001

# ======================================================
# VERCEL FRONTEND ENVIRONMENT VARIABLES
# Set in: Vercel Dashboard > Project Settings > Environment Variables
# ======================================================

# REQUIRED: Full URL of your Render backend (no trailing slash)
VITE_API_BASE_URL=https://floodguard-backend.onrender.com

# ======================================================
# RENDER BACKEND ENVIRONMENT VARIABLES
# Set in: Render Dashboard > Service > Environment
# DO NOT commit these values to git!
# ======================================================

# REQUIRED: Turso database connection
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here

# REQUIRED: Vercel frontend URL for CORS origin whitelist (no trailing slash)
# FRONTEND_URL=https://your-app.vercel.app

# OPTIONAL: Additional comma-separated origins (e.g. preview deploys)
# CORS_ALLOWED_ORIGINS=https://floodguard-preview.vercel.app,https://staging.example.com

# OPTIONAL: Set to "1" to block all *.vercel.app preview origins strictly
# STRICT_SINGLE_ORIGIN=
